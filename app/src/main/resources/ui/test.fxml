<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="800.0" prefWidth="1280.0" styleClass="test-screen"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.autotest.controller.TestController">
   <top>
      <BorderPane styleClass="test-header">
         <left>
            <Button accessibleText="Cerrar aplicación" onAction="#cerrarAplicacion"
                    styleClass="close-button">
               <graphic>
                  <ImageView fitWidth="24.0" fitHeight="24.0" preserveRatio="true">
                     <image>
                        <Image url="@../img/cerrar-sesion.png" />
                     </image>
                  </ImageView>
               </graphic>
            </Button>
         </left>
         <center>
            <Label text="Test diseño de interfaces" styleClass="test-title" />
         </center>
         <right>
            <Region prefWidth="70.0" />
         </right>
      </BorderPane>
   </top>
   <center>
      <HBox alignment="TOP_CENTER" styleClass="test-content">
         <Region HBox.hgrow="ALWAYS" />
         <ScrollPane fx:id="preguntasScrollPane" fitToWidth="true" prefWidth="900.0" maxWidth="1100.0"
                     styleClass="questions-scroll">
            <content>
               <VBox fx:id="preguntasContainer" styleClass="questions-container" />
            </content>
         </ScrollPane>
         <VBox alignment="TOP_CENTER" prefWidth="220.0" minWidth="200.0" styleClass="score-panel">
            <Button fx:id="comprobarButton" text="Corregir test"
                    onAction="#comprobar" maxWidth="Infinity" styleClass="check-button" />
            <Label fx:id="notaLabel" text="Nota: -- / 10" styleClass="score-label" />
            <Button fx:id="reiniciarButton" text="Reiniciar test"
                    onAction="#reiniciar" maxWidth="Infinity" styleClass="restart-button" />
            <VBox styleClass="score-details">
               <Label fx:id="aciertosLabel" text="Aciertos: 0" />
               <Label fx:id="fallosLabel" text="Fallos: 0" />
               <Label fx:id="sinResponderLabel" text="Sin responder: 0" />
            </VBox>
         </VBox>
         <Region HBox.hgrow="ALWAYS" />
      </HBox>
   </center>
</BorderPane>
